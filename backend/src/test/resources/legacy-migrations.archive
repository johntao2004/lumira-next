-- @legacy-migration V37__feedback_module_state.sql
-- Keep the public feedback utility available after it is registered as an optional module.
-- The row is deliberately separate from the dictionary migration so module gating has
-- an explicit initial revision and can be disabled without deleting feedback records.
INSERT INTO platform_module_state(id,module_id,enabled,version)
VALUES(gen_random_uuid(),'feedback',true,1)
ON CONFLICT(module_id) DO NOTHING;

INSERT INTO platform_module_revision(module_state_id,version,enabled,changed_by,change_reason)
SELECT id,1,true,'system','Enable feedback utility during platform migration'
FROM platform_module_state
WHERE module_id='feedback'
  AND NOT EXISTS (
    SELECT 1 FROM platform_module_revision r
    WHERE r.module_state_id=platform_module_state.id AND r.version=1
  );

INSERT INTO platform_audit(id,actor,action,target_id)
SELECT gen_random_uuid(),'system','module.enabled',id
FROM platform_module_state
WHERE module_id='feedback'
  AND NOT EXISTS (
    SELECT 1 FROM platform_audit a
    WHERE a.actor='system' AND a.action='module.enabled' AND a.target_id=platform_module_state.id
  );

-- @legacy-migration V38__feedback_file_references.sql
-- Feedback content may reference normalized shared images.  The join table
-- keeps ownership and deletion checks in one place without duplicating blobs.
CREATE TABLE platform_feedback_file (
  feedback_id UUID NOT NULL REFERENCES platform_feedback(id) ON DELETE CASCADE,
  file_id UUID NOT NULL REFERENCES platform_file(id) ON DELETE RESTRICT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  PRIMARY KEY (feedback_id, file_id)
);
CREATE INDEX platform_feedback_file_file ON platform_feedback_file(file_id);

-- @legacy-migration V39__platform_event_outbox.sql
CREATE TABLE platform_event_outbox (
  id UUID PRIMARY KEY,
  source_type VARCHAR(64) NOT NULL CHECK (source_type ~ '^[a-z][a-z0-9._:-]{0,63}$'),
  event_type VARCHAR(128) NOT NULL CHECK (event_type ~ '^[a-z][a-z0-9._:-]{0,127}$'),
  event_key VARCHAR(191) NOT NULL CHECK (event_key <> ''),
  payload JSONB NOT NULL CHECK (octet_length(payload::text) BETWEEN 2 AND 262144),
  status VARCHAR(16) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING','PROCESSING','DELIVERED','FAILED','DEAD_LETTER')),
  attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 8),
  available_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  lease_token UUID,
  lease_until TIMESTAMPTZ,
  last_error VARCHAR(1000),
  delivered_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE(source_type,event_type,event_key),
  CHECK ((status='PROCESSING') = (lease_token IS NOT NULL AND lease_until IS NOT NULL)),
  CHECK ((lease_token IS NULL) = (lease_until IS NULL)),
  CHECK ((status='DELIVERED') = (delivered_at IS NOT NULL))
);
CREATE INDEX platform_event_outbox_due ON platform_event_outbox(status,available_at,created_at,id) WHERE status='PENDING';
CREATE INDEX platform_event_outbox_lease ON platform_event_outbox(lease_until,updated_at,id) WHERE status='PROCESSING';
CREATE INDEX platform_event_outbox_created ON platform_event_outbox(created_at DESC,id DESC);

-- @legacy-migration V3__role_authorities.sql
CREATE TABLE platform_role (
 id UUID PRIMARY KEY,
 code VARCHAR(100) NOT NULL UNIQUE,
 name VARCHAR(200) NOT NULL,
 enabled BOOLEAN NOT NULL DEFAULT TRUE,
 version BIGINT NOT NULL DEFAULT 0
);
CREATE TABLE platform_role_authority (
 role_id UUID NOT NULL REFERENCES platform_role(id) ON DELETE CASCADE,
 authority VARCHAR(100) NOT NULL,
 PRIMARY KEY(role_id, authority)
);
CREATE TABLE platform_user_role (
 user_id UUID NOT NULL REFERENCES platform_user(id) ON DELETE CASCADE,
 role_id UUID NOT NULL REFERENCES platform_role(id) ON DELETE RESTRICT,
 PRIMARY KEY(user_id, role_id)
);
CREATE INDEX platform_user_role_role_idx ON platform_user_role(role_id);
CREATE VIEW platform_effective_authority AS
 SELECT user_id, authority FROM platform_authority
 UNION
 SELECT ur.user_id, ra.authority FROM platform_user_role ur
 JOIN platform_role r ON r.id=ur.role_id AND r.enabled
 JOIN platform_role_authority ra ON ra.role_id=r.id;
INSERT INTO platform_authority(user_id,authority)
 SELECT id, grant_name FROM platform_user CROSS JOIN
 (VALUES ('platform:roles:read'),('platform:roles:write')) AS grants(grant_name)
 WHERE username='admin' ON CONFLICT DO NOTHING;

-- @legacy-migration V40__platform_notifications.sql
CREATE TABLE platform_notification (
  id UUID PRIMARY KEY,
  recipient_id UUID NOT NULL REFERENCES platform_user(id) ON DELETE CASCADE,
  event_id UUID REFERENCES platform_event_outbox(id) ON DELETE SET NULL,
  dedupe_key VARCHAR(191) NOT NULL CHECK (dedupe_key ~ '^[a-z][a-z0-9._:-]{0,190}$'),
  kind VARCHAR(80) NOT NULL CHECK (kind ~ '^[a-z][a-z0-9._:-]{0,79}$'),
  title_key VARCHAR(128) NOT NULL CHECK (title_key ~ '^[a-z][a-z0-9._:-]{0,127}$'),
  body_key VARCHAR(128) NOT NULL CHECK (body_key ~ '^[a-z][a-z0-9._:-]{0,127}$'),
  params JSONB NOT NULL CHECK (octet_length(params::text) BETWEEN 2 AND 8192),
  href VARCHAR(512) CHECK (href IS NULL OR (href LIKE '/%' AND href NOT LIKE '//%')),
  read_at TIMESTAMPTZ,
  expires_at TIMESTAMPTZ,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX platform_notification_dedupe ON platform_notification(recipient_id,dedupe_key);
CREATE INDEX platform_notification_inbox ON platform_notification(recipient_id,created_at DESC,id DESC);
CREATE INDEX platform_notification_unread ON platform_notification(recipient_id,created_at DESC,id DESC) WHERE read_at IS NULL;

-- @legacy-migration V41__notification_message_key_case.sql
ALTER TABLE platform_notification
  DROP CONSTRAINT platform_notification_dedupe_key_check,
  DROP CONSTRAINT platform_notification_kind_check,
  DROP CONSTRAINT platform_notification_title_key_check,
  DROP CONSTRAINT platform_notification_body_key_check;
ALTER TABLE platform_notification
  ADD CONSTRAINT platform_notification_dedupe_key_check CHECK (dedupe_key ~ '^[A-Za-z][A-Za-z0-9._:-]{0,190}$'),
  ADD CONSTRAINT platform_notification_kind_check CHECK (kind ~ '^[A-Za-z][A-Za-z0-9._:-]{0,79}$'),
  ADD CONSTRAINT platform_notification_title_key_check CHECK (title_key ~ '^[A-Za-z][A-Za-z0-9._:-]{0,127}$'),
  ADD CONSTRAINT platform_notification_body_key_check CHECK (body_key ~ '^[A-Za-z][A-Za-z0-9._:-]{0,127}$');

-- @legacy-migration V42__platform_navigation_menus.sql
-- Versioned navigation is the single source of truth for the platform shell.
-- Built-in rows mirror the scaffold routes and remain editable only through
-- migrations; custom rows can be managed by platform:navigation:write.
CREATE TABLE platform_navigation_menu (
 id UUID PRIMARY KEY,
 parent_id UUID REFERENCES platform_navigation_menu(id) ON DELETE RESTRICT,
 menu_code VARCHAR(128) NOT NULL UNIQUE CHECK(menu_code ~ '^[a-z][a-z0-9._:-]{1,127}$'),
 label_key VARCHAR(128) NOT NULL CHECK(label_key ~ '^[a-z][a-zA-Z0-9._:-]{0,127}$'),
 label_default VARCHAR(200) NOT NULL CHECK(length(trim(label_default))>0),
 menu_type VARCHAR(16) NOT NULL CHECK(menu_type IN ('CATALOG','PAGE','ACTION')),
 section_key VARCHAR(64) CHECK(section_key IS NULL OR section_key ~ '^[a-z][a-z0-9-]{0,63}$'),
 path VARCHAR(512) CHECK(path IS NULL OR (path LIKE '/dashboard/%' AND path NOT LIKE '%?%' AND path NOT LIKE '%#%')),
 icon VARCHAR(80),
 permission_key VARCHAR(120) CHECK(permission_key IS NULL OR permission_key ~ '^[a-z][a-z0-9:._-]{0,119}$'),
 global_only BOOLEAN NOT NULL DEFAULT FALSE,
 module_id VARCHAR(100) CHECK(module_id IS NULL OR module_id ~ '^[a-z][a-z0-9-]{0,99}$'),
 sort_order INTEGER NOT NULL DEFAULT 0 CHECK(sort_order>=0 AND sort_order<=1000000),
 enabled BOOLEAN NOT NULL DEFAULT TRUE,
 built_in BOOLEAN NOT NULL DEFAULT FALSE,
 deleted BOOLEAN NOT NULL DEFAULT FALSE,
 version BIGINT NOT NULL DEFAULT 1 CHECK(version>0),
 created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
 updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
 CONSTRAINT platform_navigation_parent_self_ck CHECK(parent_id IS DISTINCT FROM id),
 CONSTRAINT platform_navigation_shape_ck CHECK(
   (menu_type='CATALOG' AND path IS NULL AND section_key IS NULL)
   OR (menu_type IN ('PAGE','ACTION') AND (path IS NOT NULL OR section_key IS NOT NULL))
 )
);
CREATE INDEX platform_navigation_parent_order_idx ON platform_navigation_menu(parent_id,sort_order,id);
CREATE INDEX platform_navigation_visible_idx ON platform_navigation_menu(enabled,deleted,sort_order,id);


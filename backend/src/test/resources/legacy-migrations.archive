-- @legacy-migration V35__feedback_dictionaries.sql
-- Preserve configured values if a dictionary with a reserved feedback code already exists.
INSERT INTO platform_dictionary(id,code,name,remark) VALUES
 (gen_random_uuid(),'work_order_feedback_status','工单反馈状态','remark=TERMINAL marks handled states'),
 (gen_random_uuid(),'work_order_feedback_priority','工单反馈优先级','Work order feedback priorities'),
 (gen_random_uuid(),'work_order_feedback_default','工单反馈默认配置','value=setting key, label=setting value')
 ON CONFLICT(code) DO NOTHING;
INSERT INTO platform_dictionary_item(id,dictionary_id,value,label,sort_order,remark)
SELECT gen_random_uuid(),d.id,v.value,v.label,v.sort_order,v.remark
FROM (VALUES
 ('work_order_feedback_status','OPEN','待处理',10,''),
 ('work_order_feedback_status','PROCESSING','处理中',20,''),
 ('work_order_feedback_status','RESOLVED','已解决',30,'TERMINAL'),
 ('work_order_feedback_status','CLOSED','已关闭',40,'TERMINAL'),
 ('work_order_feedback_priority','LOW','低',10,''),
 ('work_order_feedback_priority','NORMAL','普通',20,''),
 ('work_order_feedback_priority','HIGH','高',30,''),
 ('work_order_feedback_priority','URGENT','紧急',40,''),
 ('work_order_feedback_default','INITIAL_STATUS','OPEN',10,''),
 ('work_order_feedback_default','DEFAULT_PRIORITY','NORMAL',20,''),
 ('work_order_feedback_default','UPLOAD_BUCKET','support_feedback',30,''),
 ('work_order_feedback_default','IMAGE_CATEGORY','工单反馈',40,''),
 ('work_order_feedback_default','IMAGE_REMARK','工单反馈富文本图片',50,'')
) AS v(code,value,label,sort_order,remark)
JOIN platform_dictionary d ON d.code=v.code
ON CONFLICT(dictionary_id,value) DO NOTHING;


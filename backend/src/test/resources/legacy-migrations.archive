);
INSERT INTO platform_authority(user_id,authority)
 SELECT id,grant_name FROM platform_user CROSS JOIN
 (VALUES ('platform:settings:read'),('platform:settings:write')) AS grants(grant_name)
 WHERE username='admin' ON CONFLICT DO NOTHING;

-- @legacy-migration V13__setting_rollback_source.sql
ALTER TABLE platform_setting_revision ADD COLUMN source_version BIGINT;
ALTER TABLE platform_setting_revision ADD CONSTRAINT setting_revision_source
 FOREIGN KEY(setting_id,source_version) REFERENCES platform_setting_revision(setting_id,version);

-- @legacy-migration V14__configuration_recovery_guard.sql
-- Settings recovery needs both a global writer and access to read the current version/UI.
CREATE VIEW platform_recovery_capability AS
 SELECT g.user_id,g.authority AS capability FROM platform_global_authority g
 WHERE g.authority IN ('platform:users:write','platform:roles:write')
 OR (g.authority='platform:settings:write' AND EXISTS(
  SELECT 1 FROM platform_effective_authority a WHERE a.user_id=g.user_id AND a.authority='platform:settings:read'));

CREATE FUNCTION platform_has_recovery_administrators() RETURNS BOOLEAN LANGUAGE sql STABLE AS $$
 SELECT NOT EXISTS(
  SELECT 1 FROM (VALUES ('platform:users:write'),('platform:roles:write'),('platform:settings:write')) required(capability)
  WHERE NOT EXISTS(SELECT 1 FROM platform_recovery_capability c JOIN platform_user u ON u.id=c.user_id
   WHERE u.enabled AND c.capability=required.capability))
$$;

CREATE FUNCTION platform_is_last_recovery_administrator(target UUID) RETURNS BOOLEAN LANGUAGE sql STABLE AS $$
 SELECT EXISTS(SELECT 1 FROM platform_recovery_capability own WHERE own.user_id=target
  AND NOT EXISTS(SELECT 1 FROM platform_recovery_capability other JOIN platform_user u ON u.id=other.user_id
   WHERE u.enabled AND u.id<>target AND other.capability=own.capability))
$$;

-- @legacy-migration V15__profile_custom_values.sql
ALTER TABLE platform_user ADD COLUMN profile_values JSONB NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(profile_values)='object');

-- @legacy-migration V16__profile_dictionary_selections.sql
CREATE TABLE platform_profile_dictionary_selection (
 user_id UUID NOT NULL REFERENCES platform_user(id) ON DELETE CASCADE,
 field_key VARCHAR(64) NOT NULL,
 item_id UUID NOT NULL REFERENCES platform_dictionary_item(id) ON DELETE RESTRICT,
 PRIMARY KEY(user_id,field_key)
);
CREATE INDEX platform_profile_dictionary_selection_item ON platform_profile_dictionary_selection(item_id);
-- Include retained hidden/retired values whose dictionary binding exists in schema history.
WITH schemas AS (
 SELECT payload FROM platform_setting WHERE section='profile-fields'
 UNION ALL
 SELECT r.payload FROM platform_setting_revision r JOIN platform_setting s ON s.id=r.setting_id WHERE s.section='profile-fields'
), definitions AS (
 SELECT DISTINCT field->>'key' AS field_key,field->>'dictionaryCode' AS dictionary_code
 FROM schemas CROSS JOIN LATERAL jsonb_array_elements(payload->'fields') field
 WHERE field->>'dictionaryCode' IS NOT NULL
)
INSERT INTO platform_profile_dictionary_selection(user_id,field_key,item_id)
SELECT DISTINCT u.id,f.field_key,i.id FROM definitions f
 JOIN platform_dictionary d ON d.code=f.dictionary_code
 JOIN platform_dictionary_item i ON i.dictionary_id=d.id
 JOIN platform_user u ON u.profile_values->>f.field_key=i.id::text
ON CONFLICT(user_id,field_key) DO NOTHING;

-- @legacy-migration V17__file_metadata.sql
-- Metadata is reserved before streaming bytes. Storage keys never contain client filenames.
CREATE TABLE platform_file (
 id UUID PRIMARY KEY,
 owner_id UUID REFERENCES platform_user(id) ON DELETE SET NULL,
 storage_backend VARCHAR(32) NOT NULL,
 original_name VARCHAR(255) NOT NULL CHECK (length(original_name)>0),
 state VARCHAR(16) NOT NULL DEFAULT 'UPLOADING' CHECK (state IN ('UPLOADING','READY','DELETING')),
 size_bytes BIGINT CHECK (size_bytes>=0),
 sha256 VARCHAR(64) CHECK (sha256 ~ '^[0-9a-f]{64}$'),
 version BIGINT NOT NULL DEFAULT 0 CHECK (version>=0),
 created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
 updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
 CHECK ((size_bytes IS NULL)=(sha256 IS NULL)),
 CHECK (state<>'READY' OR (size_bytes IS NOT NULL AND sha256 IS NOT NULL))
);
CREATE INDEX platform_file_owner_created ON platform_file(owner_id,created_at DESC,id);
CREATE INDEX platform_file_cleanup ON platform_file(state,updated_at,id);

-- @legacy-migration V18__file_quota_reservations.sql
-- Preserve the worst-case reservation for uploads whose byte count is not yet known.
ALTER TABLE platform_file ADD COLUMN reserved_bytes BIGINT NOT NULL DEFAULT 20971520 CHECK (reserved_bytes>=0);
ALTER TABLE platform_file ADD CONSTRAINT platform_file_size_within_reservation CHECK (size_bytes IS NULL OR size_bytes<=reserved_bytes);

-- @legacy-migration V19__upload_deadlines.sql
ALTER TABLE platform_file ADD COLUMN upload_expires_at TIMESTAMPTZ;
UPDATE platform_file SET upload_expires_at=created_at+interval '15 minutes';
ALTER TABLE platform_file ALTER COLUMN upload_expires_at SET NOT NULL;
ALTER TABLE platform_file ALTER COLUMN upload_expires_at SET DEFAULT (now()+interval '15 minutes');
CREATE INDEX platform_file_upload_expiry ON platform_file(upload_expires_at,id) WHERE state='UPLOADING';


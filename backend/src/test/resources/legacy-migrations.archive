-- @legacy-migration V47__sms_delivery_and_account_phone.sql
-- Provider-neutral SMS delivery and account phone verification.
-- Payloads are encrypted by the application; the database never stores a code in clear text.
CREATE TABLE platform_sms_delivery (
  id UUID PRIMARY KEY,
  payload VARCHAR(90000) NOT NULL CHECK (payload ~ '^v1:[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$'),
  state VARCHAR(20) NOT NULL DEFAULT 'PENDING' CHECK (state IN ('PENDING','LEASED','SENDING','ACCEPTED','FAILED','UNCERTAIN','EXPIRED')),
  attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 5),
  available_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  expires_at TIMESTAMPTZ NOT NULL,
  lease_token UUID,
  lease_until TIMESTAMPTZ,
  last_result VARCHAR(40) CHECK (last_result IN ('ACCEPTED','AUTHENTICATION_FAILED','CONNECTION_FAILED','DELIVERY_UNCERTAIN','CONFIGURATION_UNAVAILABLE','LEASE_EXPIRED')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  CHECK ((state IN ('LEASED','SENDING')) = (lease_token IS NOT NULL AND lease_until IS NOT NULL)),
  CHECK ((lease_token IS NULL) = (lease_until IS NULL))
);
CREATE INDEX platform_sms_pending ON platform_sms_delivery(available_at,created_at,id) WHERE state='PENDING';
CREATE INDEX platform_sms_pending_expiry ON platform_sms_delivery(expires_at) WHERE state='PENDING';
CREATE INDEX platform_sms_leases ON platform_sms_delivery(lease_until,updated_at,id) WHERE state IN ('LEASED','SENDING');

CREATE TABLE platform_account_phone (
  user_id UUID PRIMARY KEY REFERENCES platform_user(id) ON DELETE CASCADE,
  phone VARCHAR(16),
  verified_at TIMESTAMPTZ,
  version BIGINT NOT NULL DEFAULT 0 CHECK (version>=0),
  pending_phone VARCHAR(16),
  token_hash VARCHAR(64),
  expires_at TIMESTAMPTZ,
  requested_at TIMESTAMPTZ,
  request_day DATE,
  request_count INTEGER NOT NULL DEFAULT 0 CHECK (request_count BETWEEN 0 AND 10),
  failures INTEGER NOT NULL DEFAULT 0 CHECK (failures BETWEEN 0 AND 5),
  CHECK ((phone IS NULL) = (verified_at IS NULL)),
  CHECK ((pending_phone IS NULL) = (token_hash IS NULL)),
  CHECK ((pending_phone IS NULL) = (expires_at IS NULL)),
  CHECK (token_hash IS NULL OR token_hash ~ '^[a-f0-9]{64}$')
);
CREATE UNIQUE INDEX platform_account_phone_unique ON platform_account_phone(phone) WHERE phone IS NOT NULL;
CREATE INDEX platform_account_phone_pending ON platform_account_phone(requested_at) WHERE pending_phone IS NOT NULL;


 VALUES(gen_random_uuid(),'localization',true,1)
 ON CONFLICT(module_id) DO NOTHING;
INSERT INTO platform_module_revision(module_state_id,version,enabled,changed_by,change_reason)
 SELECT id,1,true,'system','Enable runtime localization during platform migration'
 FROM platform_module_state
 WHERE module_id='localization'
   AND NOT EXISTS (
     SELECT 1 FROM platform_module_revision r
     WHERE r.module_state_id=platform_module_state.id AND r.version=1
   );
INSERT INTO platform_audit(id,actor,action,target_id)
 SELECT gen_random_uuid(),'system','module.enabled',id
 FROM platform_module_state
 WHERE module_id='localization'
   AND NOT EXISTS (
     SELECT 1 FROM platform_audit a
     WHERE a.actor='system' AND a.action='module.enabled' AND a.target_id=platform_module_state.id
   );


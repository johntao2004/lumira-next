-- @legacy-migration V43__navigation_route_uniqueness.sql
-- A PAGE is addressed by its safe section key and/or dashboard path. Keep
-- both addresses unique so the runtime tree can never resolve an ambiguous
-- destination, including when two administrators write concurrently.
CREATE UNIQUE INDEX platform_navigation_page_section_uq
  ON platform_navigation_menu(section_key)
  WHERE deleted=false AND menu_type='PAGE' AND section_key IS NOT NULL;

CREATE UNIQUE INDEX platform_navigation_page_path_uq
  ON platform_navigation_menu(path)
  WHERE deleted=false AND menu_type='PAGE' AND path IS NOT NULL;

-- @legacy-migration V44__navigation_component_keys.sql
-- A PAGE may point at a code-defined component. The value is only an
-- identifier; it is never a class name, URL, template, or executable code.
ALTER TABLE platform_navigation_menu
  ADD COLUMN component_key VARCHAR(128)
  CHECK(component_key IS NULL OR component_key ~ '^[a-z][a-z0-9._:-]{1,127}$');

ALTER TABLE platform_navigation_menu
  ADD CONSTRAINT platform_navigation_component_shape_ck
  CHECK(menu_type <> 'CATALOG' OR component_key IS NULL);

-- @legacy-migration V45__sensitive_word_module.sql
-- Public-platform sensitive-word policy and dictionary.
-- Words are normalized for matching, while the original spelling is retained
-- for an administrator's own dictionary view.  Soft deletion allows an
-- address to be reused without destroying the audit trail.
CREATE TABLE platform_sensitive_word (
  id UUID PRIMARY KEY,
  word VARCHAR(128) NOT NULL CHECK (length(trim(word)) > 0),
  normalized_word VARCHAR(128) NOT NULL CHECK (length(trim(normalized_word)) > 0),
  category VARCHAR(64) NOT NULL DEFAULT 'DEFAULT' CHECK (length(trim(category)) > 0),
  severity VARCHAR(16) NOT NULL DEFAULT 'MEDIUM' CHECK (severity IN ('LOW','MEDIUM','HIGH','CRITICAL')),
  action VARCHAR(16) NOT NULL DEFAULT 'BLOCK' CHECK (action IN ('BLOCK','LOG_ONLY')),
  enabled BOOLEAN NOT NULL DEFAULT TRUE,
  deleted BOOLEAN NOT NULL DEFAULT FALSE,
  version BIGINT NOT NULL DEFAULT 1 CHECK (version > 0),
  created_by VARCHAR(100) NOT NULL CHECK (length(trim(created_by)) > 0),
  updated_by VARCHAR(100) NOT NULL CHECK (length(trim(updated_by)) > 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX platform_sensitive_word_normalized_uq
  ON platform_sensitive_word(normalized_word) WHERE deleted=false;
CREATE INDEX platform_sensitive_word_enabled_idx
  ON platform_sensitive_word(enabled,deleted,updated_at DESC,id);

-- Least-privilege grants are separate from the settings administrator grant.
INSERT INTO platform_authority(user_id,authority)
 SELECT id,authority FROM platform_user
 CROSS JOIN (VALUES
   ('platform:sensitive-words:read'),
   ('platform:sensitive-words:write'),
   ('platform:sensitive-words:import')
 ) grants(authority)
 WHERE username='admin' ON CONFLICT DO NOTHING;

-- Register as an optional public-platform module.  The state/revision pair is
-- idempotent so a dump/restore can be replayed safely.
INSERT INTO platform_module_state(id,module_id,enabled,version)
 VALUES(gen_random_uuid(),'sensitive-words',true,1)
 ON CONFLICT(module_id) DO NOTHING;
INSERT INTO platform_module_revision(module_state_id,version,enabled,changed_by,change_reason)
 SELECT id,1,true,'system','Enable sensitive-word policy during platform migration'
 FROM platform_module_state
 WHERE module_id='sensitive-words'
   AND NOT EXISTS (
     SELECT 1 FROM platform_module_revision r
     WHERE r.module_state_id=platform_module_state.id AND r.version=1
   );
INSERT INTO platform_audit(id,actor,action,target_id)
 SELECT gen_random_uuid(),'system','module.enabled',id
 FROM platform_module_state
 WHERE module_id='sensitive-words'
   AND NOT EXISTS (
     SELECT 1 FROM platform_audit a
     WHERE a.actor='system' AND a.action='module.enabled' AND a.target_id=platform_module_state.id
   );

-- The menu is part of the server-owned tree and is hidden automatically when
-- the optional module is disabled or the read grant is absent.
INSERT INTO platform_navigation_menu(
  id,parent_id,menu_code,label_key,label_default,menu_type,section_key,path,
  permission_key,global_only,module_id,sort_order,built_in
)
VALUES (
  '00000000-0000-0000-0000-000000000038',
  '00000000-0000-0000-0000-000000000003',
  'sensitive-words','sensitiveWords','敏感词策略','PAGE','sensitive-words',
  '/dashboard/sensitive-words','platform:sensitive-words:read',true,
  'sensitive-words',70,true
)
ON CONFLICT (menu_code) DO NOTHING;

-- @legacy-migration V46__localization_module.sql
-- Runtime localization catalog.  Entries are versioned as one row so a
-- language bundle can be read in a single indexed query and published
-- atomically without partially visible translations.
CREATE TABLE platform_localization_entry (
  id UUID PRIMARY KEY,
  message_key VARCHAR(200) NOT NULL CHECK (message_key ~ '^[A-Za-z][A-Za-z0-9_.:-]{0,199}$'),
  namespace VARCHAR(80) NOT NULL DEFAULT 'platform' CHECK (namespace ~ '^[a-z][a-z0-9_.-]{0,79}$'),
  default_message VARCHAR(2000) NOT NULL CHECK (length(trim(default_message)) > 0),
  translations JSONB NOT NULL DEFAULT '{}'::jsonb CHECK (jsonb_typeof(translations) = 'object'),
  enabled BOOLEAN NOT NULL DEFAULT TRUE,
  deleted BOOLEAN NOT NULL DEFAULT FALSE,
  version BIGINT NOT NULL DEFAULT 1 CHECK (version > 0),
  created_by VARCHAR(100) NOT NULL CHECK (length(trim(created_by)) > 0),
  updated_by VARCHAR(100) NOT NULL CHECK (length(trim(updated_by)) > 0),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX platform_localization_entry_key_uq
  ON platform_localization_entry(message_key) WHERE deleted = false;
CREATE INDEX platform_localization_entry_list_idx
  ON platform_localization_entry(namespace, enabled, deleted, updated_at DESC, id);

-- A release counter is used as a cheap cache validator for public bundles.
CREATE TABLE platform_localization_release (
  locale_code VARCHAR(20) PRIMARY KEY CHECK (locale_code ~ '^[a-z]{2,3}(?:-[A-Z][a-z]{2,4})?$'),
  release_version BIGINT NOT NULL DEFAULT 0 CHECK (release_version >= 0),
  published_by VARCHAR(100) NOT NULL CHECK (length(trim(published_by)) > 0),
  published_at TIMESTAMPTZ NOT NULL DEFAULT now()
);


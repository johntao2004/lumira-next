# Historical SQL fixtures. Not scanned by Flyway.

-- @legacy-migration V10__dictionary_types.sql
CREATE TABLE platform_dictionary (
 id UUID PRIMARY KEY,
 code VARCHAR(100) NOT NULL UNIQUE,
 name VARCHAR(200) NOT NULL,
 enabled BOOLEAN NOT NULL DEFAULT TRUE,
 structure VARCHAR(8) NOT NULL DEFAULT 'FLAT' CHECK(structure IN ('FLAT','TREE')),
 remark VARCHAR(1000) NOT NULL DEFAULT '',
 version BIGINT NOT NULL DEFAULT 0
);
INSERT INTO platform_authority(user_id,authority)
 SELECT id,grant_name FROM platform_user CROSS JOIN
 (VALUES ('platform:dictionaries:read'),('platform:dictionaries:write')) AS grants(grant_name)
 WHERE username='admin' ON CONFLICT DO NOTHING;

-- @legacy-migration V11__dictionary_items.sql
CREATE TABLE platform_dictionary_item (
 id UUID PRIMARY KEY,
 dictionary_id UUID NOT NULL REFERENCES platform_dictionary(id) ON DELETE RESTRICT,
 parent_id UUID,
 value VARCHAR(200) NOT NULL,
 label VARCHAR(200) NOT NULL,
 sort_order INTEGER NOT NULL DEFAULT 0,
 enabled BOOLEAN NOT NULL DEFAULT TRUE,
 remark VARCHAR(1000) NOT NULL DEFAULT '',
 version BIGINT NOT NULL DEFAULT 0,
 UNIQUE(dictionary_id,value),
 UNIQUE(dictionary_id,id),
 FOREIGN KEY(dictionary_id,parent_id) REFERENCES platform_dictionary_item(dictionary_id,id) ON DELETE RESTRICT,
 CHECK(id IS DISTINCT FROM parent_id)
);
CREATE INDEX platform_dictionary_item_parent_idx ON platform_dictionary_item(dictionary_id,parent_id,sort_order,id);


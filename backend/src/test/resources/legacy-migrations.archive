-- @legacy-migration V20__shared_rate_buckets.sql
-- Preserve live login counters while sharing the atomic bucket implementation with uploads.
ALTER TABLE platform_login_bucket RENAME TO platform_rate_bucket;
ALTER INDEX platform_login_bucket_window_idx RENAME TO platform_rate_bucket_window_idx;

-- @legacy-migration V21__orphan_file_retention.sql
ALTER TABLE platform_file ADD COLUMN orphaned_at TIMESTAMPTZ;
-- Existing ownerless files receive the full retention period from this migration.
UPDATE platform_file SET orphaned_at=clock_timestamp() WHERE owner_id IS NULL;
ALTER TABLE platform_file ADD CONSTRAINT platform_file_orphan_owner_consistency CHECK ((owner_id IS NULL)=(orphaned_at IS NOT NULL));
CREATE FUNCTION platform_file_track_owner() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF NEW.owner_id IS NOT NULL THEN
  NEW.orphaned_at=NULL;
 ELSIF TG_OP='INSERT' THEN
  NEW.orphaned_at=clock_timestamp();
 ELSIF OLD.owner_id IS NOT NULL OR NEW.orphaned_at IS NULL THEN
  NEW.orphaned_at=clock_timestamp();
 END IF;
 RETURN NEW;
END $$;
CREATE TRIGGER platform_file_track_owner BEFORE INSERT OR UPDATE OF owner_id ON platform_file FOR EACH ROW EXECUTE FUNCTION platform_file_track_owner();
CREATE INDEX platform_file_orphan_retention ON platform_file(orphaned_at,id) WHERE owner_id IS NULL AND state='READY';

-- @legacy-migration V22__account_avatars.sql
ALTER TABLE platform_file ADD COLUMN media_type VARCHAR(100) NOT NULL DEFAULT 'application/octet-stream'
 CHECK(media_type IN ('application/octet-stream','image/png'));
-- Composite reference makes ownership, readiness and normalized type database invariants.
ALTER TABLE platform_file ADD CONSTRAINT platform_file_avatar_target UNIQUE(id,owner_id,state,media_type);
CREATE TABLE platform_account_media (
 user_id UUID PRIMARY KEY REFERENCES platform_user(id) ON DELETE CASCADE,
 avatar_file_id UUID,
 version BIGINT NOT NULL DEFAULT 0 CHECK(version>=0),
 file_state VARCHAR(20) GENERATED ALWAYS AS ('READY') STORED,
 media_type VARCHAR(100) GENERATED ALWAYS AS ('image/png') STORED,
 FOREIGN KEY(avatar_file_id,user_id,file_state,media_type)
   REFERENCES platform_file(id,owner_id,state,media_type)
);
CREATE INDEX platform_account_media_avatar ON platform_account_media(avatar_file_id) WHERE avatar_file_id IS NOT NULL;

-- @legacy-migration V23__encrypted_secrets.sql
CREATE TABLE platform_secret (
 secret_context VARCHAR(512) PRIMARY KEY CHECK(secret_context ~ '^[A-Za-z0-9_:/.-]+$'),
 ciphertext VARCHAR(90000) CHECK(ciphertext IS NULL OR ciphertext ~ '^v1:[A-Za-z0-9_-]{1,32}:[A-Za-z0-9_-]{38,}$'),
 version BIGINT NOT NULL CHECK(version>0),
 updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
-- Clearing preserves the row/version. A stale initial writer cannot resurrect a removed credential.

-- @legacy-migration V24__mail_delivery_queue.sql
CREATE TABLE platform_mail_delivery (
 id UUID PRIMARY KEY,
 payload VARCHAR(90000) NOT NULL CHECK (payload ~ '^v1:[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$'),
 state VARCHAR(20) NOT NULL DEFAULT 'PENDING' CHECK (state IN ('PENDING','LEASED','SENDING','ACCEPTED','FAILED','UNCERTAIN','EXPIRED')),
 attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 5),
 available_at TIMESTAMPTZ NOT NULL DEFAULT now(),
 expires_at TIMESTAMPTZ NOT NULL,
 lease_token UUID,
 lease_until TIMESTAMPTZ,
 last_result VARCHAR(40) CHECK (last_result IN ('ACCEPTED','AUTHENTICATION_FAILED','CONNECTION_FAILED','DELIVERY_UNCERTAIN','CONFIGURATION_UNAVAILABLE','LEASE_EXPIRED')),
 created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
 updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
 CHECK ((state IN ('LEASED','SENDING')) = (lease_token IS NOT NULL AND lease_until IS NOT NULL)),
 CHECK ((lease_token IS NULL) = (lease_until IS NULL))
);
CREATE INDEX platform_mail_pending ON platform_mail_delivery(available_at,created_at,id) WHERE state='PENDING';
CREATE INDEX platform_mail_pending_expiry ON platform_mail_delivery(expires_at) WHERE state='PENDING';
CREATE INDEX platform_mail_leases ON platform_mail_delivery(lease_until) WHERE state IN ('LEASED','SENDING');

-- @legacy-migration V25__account_email_verification.sql
CREATE TABLE platform_account_email (
 user_id UUID PRIMARY KEY REFERENCES platform_user(id) ON DELETE CASCADE,
 email VARCHAR(254),
 verified_at TIMESTAMPTZ,
 version BIGINT NOT NULL DEFAULT 0 CHECK (version>=0),
 pending_email VARCHAR(254),
 token_hash VARCHAR(64),
 expires_at TIMESTAMPTZ,
 requested_at TIMESTAMPTZ,
 request_day DATE,
 request_count INTEGER NOT NULL DEFAULT 0 CHECK (request_count BETWEEN 0 AND 10),
 failures INTEGER NOT NULL DEFAULT 0 CHECK (failures BETWEEN 0 AND 5),
 CHECK ((email IS NULL) = (verified_at IS NULL)),
 CHECK ((pending_email IS NULL) = (token_hash IS NULL)),
 CHECK ((pending_email IS NULL) = (expires_at IS NULL)),
 CHECK (token_hash IS NULL OR token_hash ~ '^[a-f0-9]{64}$')
);
CREATE UNIQUE INDEX platform_account_email_unique ON platform_account_email(lower(email)) WHERE email IS NOT NULL;

-- @legacy-migration V26__password_reset_challenges.sql
CREATE TABLE platform_password_reset (
 user_id UUID PRIMARY KEY REFERENCES platform_user(id) ON DELETE CASCADE,
 token_hash VARCHAR(64),
 password_snapshot TEXT,
 email_version BIGINT,
 expires_at TIMESTAMPTZ,
 requested_at TIMESTAMPTZ NOT NULL,
 request_day DATE NOT NULL,
 request_count INTEGER NOT NULL CHECK (request_count BETWEEN 1 AND 10),
 failures INTEGER NOT NULL DEFAULT 0 CHECK (failures BETWEEN 0 AND 5),
 CHECK (token_hash IS NULL OR token_hash ~ '^[a-f0-9]{64}$'),
 CHECK ((token_hash IS NULL) = (password_snapshot IS NULL)),
 CHECK ((token_hash IS NULL) = (email_version IS NULL)),
 CHECK ((token_hash IS NULL) = (expires_at IS NULL))
);


 version BIGINT NOT NULL DEFAULT 0,
 CHECK(parent_id IS DISTINCT FROM id)
);
CREATE INDEX platform_organization_parent_idx ON platform_organization(parent_id);
CREATE TABLE platform_user_organization (
 user_id UUID NOT NULL REFERENCES platform_user(id) ON DELETE CASCADE,
 organization_id UUID NOT NULL REFERENCES platform_organization(id) ON DELETE RESTRICT,
 PRIMARY KEY(user_id, organization_id)
);
CREATE INDEX platform_user_organization_org_idx ON platform_user_organization(organization_id);
INSERT INTO platform_authority(user_id,authority)

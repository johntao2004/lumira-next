{
    admin off
}

:8010 {
    root * /srv
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
    # Generated at image build time by scripts/generate-csp.mjs (hashes the inline bootstrap script).
    import /etc/caddy/csp.caddy

    # Only content-hashed build outputs are immutable; unhashed public assets stay revalidated.
    @immutable path_regexp \.[0-9a-f]{8,}\.(js|css|woff2)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    try_files {path} /index.html
    file_server
}

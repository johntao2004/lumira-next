{
    admin off
}
:8010 {
    # Security headers are owned by the upstreams (Spring Security for /api, web.Caddyfile for the
    # static site); setting them here as well would emit every header twice.
    # Operational endpoints (metrics, health) are for the private network only; never route them.
    @actuator path /actuator /actuator/*
    handle @actuator {
        respond 404
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy server:8090 {
            header_up X-Lumira-Client-IP {remote_host}
            header_up -Forwarded
            header_up -X-Real-IP
        }
    }
    handle {
        reverse_proxy web:8010 {
            header_up -X-Lumira-Client-IP
        }
    }
}

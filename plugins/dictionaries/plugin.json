{
  "formatVersion": 1,
  "id": "dictionaries",
  "name": "字典管理",
  "version": "1.0.0",
  "sdkVersion": "1",
  "entryClass": "com.lumira.plugins.dictionaries.LumiraPlugin",
  "backend": "backend/plugin.jar",
  "frontend": "frontend/plugin.js",
  "dependencies": [
    {
      "id": "identity",
      "version": "1.0.0"
    },
    {
      "id": "platform",
      "version": "1.0.0"
    }
  ],
  "permissions": [
    "platform:dictionaries:access",
    "platform:dictionaries:create",
    "platform:dictionaries:update",
    "platform:dictionaries:delete",
    "platform:dictionaries:import",
    "platform:dictionaries:export"
  ],
  "routes": [

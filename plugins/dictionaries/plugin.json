        "create": "platform:dictionaries:create",
        "update": "platform:dictionaries:update",
        "delete": "platform:dictionaries:delete",
        "import": "platform:dictionaries:import",
        "export": "platform:dictionaries:export"
      },
      "group": "content-management",
      "order": 20,
      "global": true
    }
  ],

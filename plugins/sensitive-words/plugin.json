{
  "formatVersion": 1,
  "id": "sensitive-words",
  "name": "敏感词策略",
  "version": "1.0.5",
  "sdkVersion": "1",
  "entryClass": "com.lumira.platform.sensitive.LumiraPlugin",
  "backend": "backend/plugin.jar",
  "frontend": "frontend/plugin.js",
  "dependencies": [
    {
      "id": "platform",
      "version": "1.0.0"
    },
    {
      "id": "dictionaries",
      "version": "1.0.0"
    }
  ],
  "permissions": [
    "platform:sensitive-words:import",
    "platform:sensitive-words:read",
    "platform:sensitive-words:write"
  ],
  "routes": [
    {
      "id": "sensitive-words",
      "label": "sensitiveWords",
      "permission": "platform:sensitive-words:read",
      "group": "content-management",
      "order": 30,
      "global": true
    }
  ],
  "apiRules": [
    {
      "method": "GET",
      "path": "/api/platform/sensitive-policies/roles",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/sensitive-policies/hits",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/sensitive-policies/preview",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "PUT",
      "path": "/api/platform/sensitive-policies/roles/*",
      "authorities": [
        "platform:sensitive-words:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/sensitive-words",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/sensitive-words/*",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/sensitive-words/check",
      "authorities": [
        "platform:sensitive-words:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/sensitive-words/import",
      "authorities": [
        "platform:sensitive-words:import"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/sensitive-words",
      "authorities": [
        "platform:sensitive-words:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "PUT",
      "path": "/api/platform/sensitive-words/*",
      "authorities": [
        "platform:sensitive-words:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "PATCH",
      "path": "/api/platform/sensitive-words/*/status",
      "authorities": [
        "platform:sensitive-words:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "DELETE",
      "path": "/api/platform/sensitive-words/*",
      "authorities": [
        "platform:sensitive-words:write"
      ],
      "global": true,
      "publicAccess": false
    }
  ],
  "dataSets": [
    {
      "table": "platform_content_policy_hit",
      "label": "pluginDataPolicyHits",
      "column": null,
      "value": null
    },
    {
      "table": "platform_sensitive_role_policy",
      "label": "pluginDataRolePolicies",
      "column": null,
      "value": null
    },
    {
      "table": "platform_sensitive_word",
      "label": "pluginDataWords",
      "column": null,
      "value": null
    }
  ]
}

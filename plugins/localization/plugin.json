{
  "formatVersion": 1,
  "id": "localization",
  "name": "运行时本地化",
  "version": "1.0.6",
  "sdkVersion": "1",
  "entryClass": "com.lumira.platform.localization.LumiraPlugin",
  "backend": "backend/plugin.jar",
  "frontend": "frontend/plugin.js",
  "dependencies": [
    {
      "id": "platform",
      "version": "1.0.0"
    }
  ],
  "permissions": [
    "platform:localization:import",
    "platform:localization:read",
    "platform:localization:write"
  ],
  "routes": [
    {
      "id": "localization",
      "label": "localizationManagement",
      "permission": "platform:localization:read",
      "group": "administration",
      "order": 200,
      "global": true
    }
  ],
  "apiRules": [
    {
      "method": "GET",
      "path": "/api/platform/localization/entries",
      "authorities": [
        "platform:localization:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/localization/entries/*",
      "authorities": [
        "platform:localization:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/localization/locales",
      "authorities": [
        "platform:localization:read"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/entries",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "PUT",
      "path": "/api/platform/localization/entries/*",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "PATCH",
      "path": "/api/platform/localization/entries/*/status",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "DELETE",
      "path": "/api/platform/localization/entries/*",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/import",
      "authorities": [
        "platform:localization:import"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/translations",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "DELETE",
      "path": "/api/platform/localization/translations/*",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/bundle/preview",
      "authorities": [
        "platform:localization:import"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/bundle/import",
      "authorities": [
        "platform:localization:import"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/platform/localization/ai/providers",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/ai/translate",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "POST",
      "path": "/api/platform/localization/publish/*",
      "authorities": [
        "platform:localization:write"
      ],
      "global": true,
      "publicAccess": false
    },
    {
      "method": "GET",
      "path": "/api/public/localization/bundle/*",
      "authorities": [],
      "global": false,
      "publicAccess": true
    },
    {
      "method": "GET",
      "path": "/api/public/localization/locales",
      "authorities": [],
      "global": false,
      "publicAccess": true
    }
  ],
  "dataSets": [
    {
      "table": "platform_localization_entry",
      "label": "pluginDataTranslations",
      "column": null,
      "value": null
    },
    {
      "table": "platform_localization_release",
      "label": "pluginDataReleases",
      "column": null,
      "value": null
    },
    {
      "table": "platform_localization_locale",
      "label": "pluginDataLocales",
      "column": "built_in",
      "value": "false"
    }
  ]
}

{
  "formatVersion": 2,
  "id": "mfa",
  "name": "二次认证与验证器",
  "version": "1.0.10",
  "sdkVersion": "1",
  "entryClass": "com.lumira.platform.mfa.LumiraPlugin",
  "backend": "backend/plugin.jar",
  "frontend": "frontend/plugin.js",
  "dependencies": [
    {
      "id": "identity",
      "version": "1.0.0"
    }
  ],
  "permissions": [
    "platform:mfa:management-access",
    "platform:mfa:management-read",
    "platform:mfa:management-reset"
  ],
  "permissionGroups": [
    {
      "id": "administration",
      "title": "pluginPermissionGroupMfa",
      "permissions": [
        {
          "code": "platform:mfa:management-access",
          "label": "pluginPermissionMfaManagementAccess"
        },
        {
          "code": "platform:mfa:management-read",
          "label": "pluginPermissionMfaRead"
        },
        {
          "code": "platform:mfa:management-reset",
          "label": "pluginPermissionMfaReset"
        }
      ]
    }
  ],
  "routes": [
    {
      "id": "mfa-authenticator",
      "label": "mfaAuthenticator",
      "permission": null,
      "group": "user-management",
      "order": 30,
      "global": false
    },
    {
      "id": "mfa-management",
      "label": "mfaManagement",
      "permission": "platform:mfa:management-access",
      "group": "user-management",
      "order": 120,
      "global": true,
      "operations": {
        "read": "platform:mfa:management-read",
        "reset": "platform:mfa:management-reset"
      },
      "scopedOperations": [
        "reset"
      ]
    }
  ],
  "apiRules": [
    {
      "method": "GET",
      "path": "/api/mfa/account",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/setup",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/confirm",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/replacement/setup",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/replacement/confirm",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/replacement/cancel",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "POST",
      "path": "/api/mfa/account/recovery",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "PUT",
      "path": "/api/mfa/account/label",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "DELETE",
      "path": "/api/mfa/account",
      "authorities": [],
      "publicAccess": false,
      "authenticatedOnly": true,
      "global": false
    },
    {
      "method": "GET",
      "path": "/api/mfa/manage",
      "authorities": [],
      "global": true,
      "publicAccess": false,
      "allAuthorities": [
        "platform:mfa:management-access",
        "platform:mfa:management-read"
      ]
    },
    {
      "method": "POST",
      "path": "/api/mfa/manage/*/reset",
      "authorities": [],
      "global": false,
      "publicAccess": false,
      "globalAuthorities": [
        "platform:mfa:management-access"
      ],
      "allAuthorities": [
        "platform:mfa:management-access",
        "platform:mfa:management-reset"
      ]
    }
  ]
}
